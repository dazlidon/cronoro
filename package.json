{
  "name": "cronoro",
  "version": "1.0.0",
  "description": "CronoRO — Azi în istorie / Today in history",
  "private": true,
  "scripts": {
    "serve": "node serve.js 8400",
    "sync:data": "node -e \"require('fs').cpSync('data','app-ios/data',{recursive:true})\"",
    "ios:sync": "npm run sync:data && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/status-bar": "^8.0.2"
  }
}
